# Backend settings. Copy to apps/backend/.env (gitignored).
# Values below work for local development with docker-compose.dev.yml.
# Never reuse them in production.

# --- Database and Redis -------------------------------------------------------
DATABASE_URL=postgres://medusa:medusa@localhost:5432/my_medusa_store
# Setting REDIS_URL registers the Redis caching, event bus, workflow engine and
# locking modules. Leave it empty to use Medusa's in-memory fallbacks.
REDIS_URL=redis://localhost:6380
# Optional: use a separate Redis for caching or locking. Defaults to REDIS_URL.
# CACHE_REDIS_URL=
# LOCKING_REDIS_URL=

# --- CORS (comma-separated origins) -------------------------------------------
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# --- Secrets ------------------------------------------------------------------
# Production: generate each one with `openssl rand -hex 32`.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Only needed if admin users enroll in MFA. Generate the same way.
AUTH_MFA_ENCRYPTION_KEY=

# --- Deployment mode ----------------------------------------------------------
# shared (one process, the default), server (HTTP only) or worker (background only)
MEDUSA_WORKER_MODE=shared
# Set to true on the worker instance.
DISABLE_MEDUSA_ADMIN=false
# Public URL of the backend, used by the admin dashboard.
MEDUSA_BACKEND_URL=http://localhost:9000

# --- File storage placeholder (see medusa-config.ts) --------------------------
# S3_FILE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=

# --- Notification placeholder (see medusa-config.ts) --------------------------
# SENDGRID_API_KEY=
# SENDGRID_FROM=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
