# Docker Compose settings for local development. Copy to .env (gitignored).
# Backend and storefront settings live in apps/backend/.env.example and
# apps/storefront/.env.example.

# Lets a plain `docker compose up -d` find the dev compose file.
COMPOSE_FILE=docker-compose.dev.yml

# Development-only credentials. The database is bound to 127.0.0.1.
# If you change these, update DATABASE_URL in apps/backend/.env to match.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=my_medusa_store
POSTGRES_PORT=5432

# Defaults to 6380 because the host may already run Redis on 6379.
# If you change this, update REDIS_URL in apps/backend/.env to match.
REDIS_PORT=6380
